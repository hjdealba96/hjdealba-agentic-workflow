# Normalize line endings across platforms.
#
# This repository is authored from both WSL (LF) and Windows (CRLF), and the
# skills are consumed by Claude Code on Linux, macOS, and Windows. Pinning
# everything to LF keeps the stored bytes identical no matter who commits.
#
# These rules override core.autocrlf, so no per-machine git config is needed
# and clones behave the same for everyone.

# Default: treat everything as text, store and check out with LF.
* text=auto eol=lf

# Explicit rules for the file types this repository actually contains.
*.md        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
LICENSE     text eol=lf
.gitignore  text eol=lf

# Binary files — never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.pdf   binary
*.zip   binary
